# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Backend port (5001 avoids the macOS AirPlay conflict on 5000)
PORT=5001

# --- Database (Supabase Postgres) --------------------------------------------
# Supabase: Project Settings → Database → Connection string. On Vercel use the
# "Transaction pooler" string (port 6543); serverless functions open many
# short-lived connections and the pooler absorbs them. For a local Postgres:
#   DATABASE_URL=postgres://localhost/kcr_dev
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional. PEM of Supabase's server CA (Project Settings → Database → SSL
# configuration). Set it to verify the server certificate; without it the
# connection is encrypted but unverified. Newlines may be written as \n.
# DATABASE_CA_CERT=

# Optional. Connections per function instance (default 5).
# PG_POOL_MAX=5

# Optional. Set to `disable` to force plain TCP to a non-local host.
# DATABASE_SSL=

# --- Scheduled jobs ------------------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/archive and /api/cron/maintenance. Without it both routes refuse
# every call. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Email delivery for one-time sign-in codes -------------------------------
# console = print codes to the server terminal (default, no account needed)
# smtp    = actually email them
EMAIL_MODE=console

# Gmail (interim). Requires 2-Step Verification on the account, then an App
# Password from https://myaccount.google.com/apppasswords — the normal account
# password will be rejected.
#
# Gmail rewrites the From header to the authenticated account, so the address
# inside MAIL_FROM must match SMTP_USER while you're on Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM="Care Beyond <youraddress@gmail.com>"

# When the real domain is ready, point these at that provider instead
# (Resend, SendGrid, Fastmail, etc.) — no code changes required.

# ---------------------------------------------------------------------------
# Basemap tiles are configured in client/.env, not here — REACT_APP_* vars are
# read by the React build, not the server. See client/.env.example.
# Without a key the map falls back to plain OpenStreetMap, which needs no
# account; with one, both light and dark themes get their proper style.
# ---------------------------------------------------------------------------
