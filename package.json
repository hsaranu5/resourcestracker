{
  "name": "resources-tracker",
  "version": "1.0.0",
  "description": "Homelessness resources tracking application with live map and community features",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --legacy-watch server/index.js",
    "client": "cd client && CHOKIDAR_USEPOLLING=true WATCHPACK_POLLING=true npm start",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "seed": "node server/seedFromJson.js",
    "test-mail": "node server/testMail.js",
    "prod": "NODE_ENV=production node server/index.js",
    "db:schema": "node server/applySchema.js",
    "db:migrate-sqlite": "node server/migrateSqliteToPostgres.js",
    "archive": "node server/communityExport.js --run",
    "maintenance": "node server/maintenance.js"
  },
  "keywords": [
    "homelessness",
    "resources",
    "tracking",
    "community"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "sqlite3": "^5.1.7"
  }
}
