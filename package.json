{
  "name": "resources-tracker",
  "version": "1.0.0",
  "description": "Homelessness resources tracking application with live map and community features",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --legacy-watch server/index.js",
    "client": "cd client && CHOKIDAR_USEPOLLING=true WATCHPACK_POLLING=true npm start",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "seed": "node server/seed.js"
  },
  "keywords": ["homelessness", "resources", "tracking", "community"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}

